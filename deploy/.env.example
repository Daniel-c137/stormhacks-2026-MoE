# Production settings for docker-compose.yml. Copy to deploy/.env on the server, fill it in, then:
#   docker compose --env-file deploy/.env up -d --build
# Names only here; never commit values. Leave an optional setting commented out rather than empty:
# an empty number fails the brain's settings check.
# Make a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Server ---------------------------------------------------------------------------------
# The public name Caddy serves and gets a certificate for (its DNS A/AAAA record points here).
# localhost uses Caddy's own CA instead.
DOMAIN=
# Optional: true serves the brain's /api/docs and /api/openapi.json publicly (default false)
# EXPOSE_API_DOCS=

# --- Database -------------------------------------------------------------------------------
# Postgres 16 + pgvector in the postgres container, never published. Use a URL-safe password
# (python3 -c "import secrets; print(secrets.token_hex(24))").
POSTGRES_USER=moe
POSTGRES_PASSWORD=
POSTGRES_DB=moe
# Keep as is: built from the three above, host "postgres" on the compose network.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Optional: days a meeting's transcript is kept after it ends (default 14, at least 1)
# TRANSCRIPT_RETENTION_DAYS=

# --- Sign-in (brain) ------------------------------------------------------------------------
# Signs the session tokens the brain issues at sign-in; at least 32 characters (the secret recipe
# above). Unset or shorter: sign-in answers 503. Changing it signs everyone out.
AUTH_SECRET=
# Optional: hours a session lasts before signing in again (default 12, at least 1)
# SESSION_HOURS=
# Optional: invite-only sign-up (#128). A member of this team with no login yet can create their
# account on the sign-in page, with a password or Google. Unset: no sign-up. The demo team is
# team-dropsubs, but its seeded people already have logins (they sign in, not up).
# SIGNUP_TEAM_ID=
# Optional: Google sign-in and sign-up, on only with all three set. In Google Cloud, create an
# OAuth client ("Web application") with https://<DOMAIN>/api/auth/google/callback as an
# authorised redirect URI, and set GOOGLE_REDIRECT_URL to exactly that URL. The brain can't work
# it out behind Caddy, and the https makes the sign-in cookie Secure. Google sends the browser
# back to /login on the same domain, so BOARD_URL stays unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://<DOMAIN>/api/auth/google/callback

# --- Worker -> brain ------------------------------------------------------------------------
# Shared by the brain and the realtime worker for /internal calls; at least 32 characters
# (the secret recipe above). The worker reaches the brain at http://brain:8000 (set by compose).
BRAIN_INTERNAL_TOKEN=

# --- LiveKit (brain and worker) -------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: seconds a join token is valid (default 600)
# LIVEKIT_TOKEN_TTL_SECONDS=

# --- Gemini (brain) -------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated models tried in order when GEMINI_MODEL is overloaded (429/5xx) or missing (404)
GEMINI_FALLBACK_MODELS=
# Optional: tries per model (default 2) and max seconds between them (default 4)
# GEMINI_ATTEMPTS=
# GEMINI_MAX_DELAY=
GEMINI_EMBEDDING_MODEL=
# 768, to match the vector(768) column in the migrations
GEMINI_EMBEDDING_DIM=768
# Optional: comma-separated embedding models tried in order on overload or 404
# GEMINI_EMBEDDING_FALLBACK_MODELS=
# Optional: live translation (#106), only in meetings whose host turns it on. A cheaper model
# for it (default GEMINI_MODEL), tried once with no fallback, and how long the brain waits for it
# (default 3.5 seconds)
# TRANSLATION_MODEL=
# TRANSLATION_TIMEOUT_SECONDS=

# --- OpenRouter (brain, optional fallback when every Gemini model is out of capacity) -------
# Set a credit limit on the key.
# OPENROUTER_API_KEY=
# Comma-separated OpenRouter model ids tried in order
# OPENROUTER_MODELS=
# OPENROUTER_URL=
# Embeddings fallback: the same model as GEMINI_EMBEDDING_MODEL on OpenRouter, at
# GEMINI_EMBEDDING_DIM; a different model is refused
# OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001

# --- ElevenLabs (brain: voices and report audio; worker: transcription and speech) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=
# Optional: defaults to https://api.elevenlabs.io
# ELEVENLABS_API_URL=
# Optional: the language Scribe is pinned to (default en); a meeting with translation on detects
# each utterance's language instead
# ELEVENLABS_STT_LANGUAGE=
# Optional (worker): with translation on, seconds before a still-going sentence is translated
# so far (default 1.5), and seconds provisional translation pauses after a failure (default 45)
# TRANSLATION_PROVISIONAL_SECONDS=
# TRANSLATION_PAUSE_SECONDS=

# --- GitHub, GitLab and Jira (brain) --------------------------------------------------------
# By default the brain reads them through the demo-world mock MCP servers in this compose file
# (http://world-github:8101/mcp, http://world-jira:8102/mcp and http://world-gitlab:8103/mcp).
# Set these for real MCP servers; GitLab's is https://<instance>/api/v4/mcp.
# GITHUB_MCP_URL=
# JIRA_MCP_URL=
# GITLAB_MCP_URL=
# owner/name used when the team sets none; with the mocks, github_repo in world/world.json
GITHUB_REPO=
# Jira project key used when the team sets none; with the mocks, jira_project in world/world.json
JIRA_PROJECT_KEY=
# Only for real GitHub and Jira:
# GITHUB_TOKEN=
# JIRA_BASE_URL=
# JIRA_CLOUD_ID=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# Optional: seconds to reach an MCP server for the connector status (default 5)
# CONNECTOR_TIMEOUT=

# --- Write-up (brain, optional) -------------------------------------------------------------
# Seconds the write-up waits after a meeting ends for the last transcript segments (default 8)
# PIPELINE_SETTLE_SECONDS=
# Minutes without progress after which the host may retry a stuck write-up (default 10)
# PIPELINE_STALE_MINUTES=

# --- Demo world (mock MCP servers) ----------------------------------------------------------
# dev or demo (default demo here)
WORLD_SNAPSHOT=demo

# --- Demo seed (optional; world-seed in the brain container) ---------------------------------
# One demo password for every seeded person (10+ characters); unset generates one each, printed once
# WORLD_SEED_PASSWORD=
# Texts embedded per minute while seeding; 90 suits Gemini's free tier (100 a minute)
# WORLD_SEED_EMBEDS_PER_MINUTE=
