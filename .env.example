# Copy to .env at the repo root. Names only; never commit values.
# Only NEXT_PUBLIC_* values reach the browser.

# board
# Where the browser reaches the brain. Absolute (http://localhost:8000; the brain sends no CORS
# headers, so only for same-origin setups) or relative to the board, e.g. /api as production
# serves it. With a relative path, `pnpm --filter board dev` forwards it to BRAIN_URL below.
NEXT_PUBLIC_API_URL=/api

# Local Postgres from docker compose (see README): docker compose -f docker-compose.yml
# -f deploy/compose.dev.yml up -d postgres, then
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>
POSTGRES_USER=moe
POSTGRES_PASSWORD=
POSTGRES_DB=moe
# Optional: host port for it (default 5432)
# POSTGRES_PORT=

# brain
# Our own Postgres 16 with the pgvector extension, next to the app, e.g.
# postgresql://brain:...@localhost:5432/brain. Apply db/migrations first with
# `uv run brain migrate`. Unset: store routes answer 503. Also used by `uv run brain add-team`,
# `uv run brain add-user` (there is no public sign-up), `uv run brain set-admin` and
# `uv run brain purge-transcripts`.
DATABASE_URL=
# Days a meeting's transcript is kept after it ends (default 14, at least 1)
# TRANSCRIPT_RETENTION_DAYS=
# Signs the session tokens the brain issues at POST /auth/login. At least 32 characters:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset or shorter: sign-in and every signed-in route answer 503. Changing it signs everyone out.
AUTH_SECRET=
# Optional: hours a session lasts before signing in again (default 12, at least 1)
# SESSION_HOURS=
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: a cheaper Gemini model for live translation (#106; default GEMINI_MODEL). It is tried
# once with no fallback, and given up on after TRANSLATION_TIMEOUT_SECONDS (default 3.5)
# TRANSLATION_MODEL=
# TRANSLATION_TIMEOUT_SECONDS=3.5
# Comma-separated models tried in order when GEMINI_MODEL is overloaded (429/5xx) or missing
# for this key (404, logged once per model)
GEMINI_FALLBACK_MODELS=
# Optional: tries per model (default 2) and max seconds between them (default 4)
# GEMINI_ATTEMPTS=
# GEMINI_MAX_DELAY=
# Fallback when every Gemini model is out of capacity (or the only model provider); set a credit
# limit on the key. Requests only use providers that keep no data and support structured output.
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model ids tried in order on 404/408/429/5xx, e.g.
# google/gemini-3.5-flash-lite,deepseek/deepseek-v4.1-flash
OPENROUTER_MODELS=
# Optional: defaults to https://openrouter.ai/api/v1
# OPENROUTER_URL=
GEMINI_EMBEDDING_MODEL=
# 768 to match the vector(768) column in db/migrations
GEMINI_EMBEDDING_DIM=
# Comma-separated embedding models tried in order on overload or 404; search only compares vectors
# made by the same model
GEMINI_EMBEDDING_FALLBACK_MODELS=
# Embeddings fallback on OPENROUTER_API_KEY when Gemini's are out of capacity (or the only
# embeddings provider): the same model as GEMINI_EMBEDDING_MODEL, e.g. google/gemini-embedding-001,
# at GEMINI_EMBEDDING_DIM. Its vectors are stored as Gemini's; a different model is refused.
OPENROUTER_EMBEDDING_MODEL=
# MCP servers the brain reads GitHub, GitLab and Jira through (the world mocks or the real
# servers). GitLab's is served by the GitLab instance at https://<instance>/api/v4/mcp; links to
# GitLab code use that instance (gitlab.com for any other URL, like the mock's).
GITHUB_MCP_URL=http://localhost:8101/mcp
JIRA_MCP_URL=http://localhost:8102/mcp
GITLAB_MCP_URL=http://localhost:8103/mcp
GITHUB_TOKEN=
# owner/name, used when the team connects no repository; with the world mocks, github_repo in
# world/world.json. Teams connect repositories and GitLab projects in Settings (admins only).
GITHUB_REPO=
JIRA_BASE_URL=
# Atlassian cloud id; defaults to JIRA_BASE_URL
JIRA_CLOUD_ID=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Optional: seconds to reach an MCP server for the connector status (default 5)
# CONNECTOR_TIMEOUT=
# Optional: seconds the write-up waits after a meeting ends for the last transcript segments
# (default 8)
# PIPELINE_SETTLE_SECONDS=
# Optional: minutes without progress after which the host may retry a write-up that is not
# running here, e.g. after a crash (default 10)
# PIPELINE_STALE_MINUTES=

# brain + realtime
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BRAIN_URL=http://localhost:8000
# At least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRAIN_INTERNAL_TOKEN=
# brain lists the agent voices and reads reports aloud with it; realtime transcribes and speaks
ELEVENLABS_API_KEY=
# Optional: defaults to https://api.elevenlabs.io
# ELEVENLABS_API_URL=
# The agent's default voice and speech model: realtime's spoken answers and the report's Listen
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=

# realtime
# The Scribe Realtime model, e.g. scribe_v2_realtime (livekit-plugins-elevenlabs' default,
# scribe_v1, is retired)
ELEVENLABS_STT_MODEL=
# Optional: the language Scribe is pinned to, ISO 639-1 (default en). A meeting whose host turned
# live translation on (#106) lets Scribe detect each utterance's language instead.
# ELEVENLABS_STT_LANGUAGE=
# Optional: with translation on, how long a sentence may run before a provisional translation
# is shown (default 1.5 seconds), and how long provisional translation pauses after the model
# fails (default 45)
# TRANSLATION_PROVISIONAL_SECONDS=1.5
# TRANSLATION_PAUSE_SECONDS=45
# Optional: seconds between the worker's agenda and fact-check ticks (defaults 30 and 60)
# AGENDA_TICK_SECONDS=
# FACT_CHECK_TICK_SECONDS=
# Optional: a spoken answer stops after its last whole sentence within this many characters
# (default 600)
# SPOKEN_ANSWER_MAX_CHARS=

# world
# Also the snapshot `uv run world-seed` seeds by default (dev has no past meetings; demo has
# four). world-seed needs DATABASE_URL, a model (GEMINI_* or OPENROUTER_*) and GEMINI_EMBEDDING_*
# (or OPENROUTER_EMBEDDING_MODEL).
WORLD_SNAPSHOT=dev
# Optional: world-seed embeds at most this many texts a minute; set 90 on Gemini's free tier,
# which counts each text against 100 a minute (a past meeting has about 350)
# WORLD_SEED_EMBEDS_PER_MINUTE=
# world-seed: one demo password for every seeded person (10+ characters); unset generates
# one each and prints it once
WORLD_SEED_PASSWORD=
WORLD_TODAY_OVERRIDE=
# Optional: ports of the mock GitHub, Jira and GitLab MCP servers (defaults 8101, 8102 and 8103)
# WORLD_GITHUB_MCP_PORT=
# WORLD_JIRA_MCP_PORT=
# WORLD_GITLAB_MCP_PORT=
# Optional: address the mocks listen on (default 127.0.0.1; 0.0.0.0 in a container)
# WORLD_MCP_HOST=
# Optional: where the mocks journal their writes (default world/.overlay); uv run world-reset
# clears it
# WORLD_OVERLAY_DIR=
