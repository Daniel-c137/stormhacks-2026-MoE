# Copy to .env at the repo root. Names only; never commit values.
# Only NEXT_PUBLIC_* values reach the browser.

# board
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# brain
# Postgres the brain stores meetings in: Supabase's connection string, or any local Postgres.
# Apply supabase/migrations first (Supabase CLI, or `uv run brain migrate`). Unset: store
# routes answer 503. Also used by `uv run brain purge-transcripts`.
DATABASE_URL=
# Days a meeting's transcript is kept after it ends (default 14, at least 1)
# TRANSCRIPT_RETENTION_DAYS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret. Without it, sessions verify against SUPABASE_URL's signing keys (JWKS).
SUPABASE_JWT_SECRET=
# Optional: expected access-token audience (default authenticated)
# SUPABASE_JWT_AUDIENCE=
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated models tried in order when GEMINI_MODEL is overloaded (429/5xx) or missing
# for this key (404, logged once per model)
GEMINI_FALLBACK_MODELS=
# Optional: tries per model (default 2) and max seconds between them (default 4)
# GEMINI_ATTEMPTS=
# GEMINI_MAX_DELAY=
GEMINI_EMBEDDING_MODEL=
# 768 to match the vector(768) column in supabase/migrations
GEMINI_EMBEDDING_DIM=
# Comma-separated embedding models tried in order on overload or 404; search only compares vectors
# made by the same model
GEMINI_EMBEDDING_FALLBACK_MODELS=
# MCP servers the brain reads GitHub and Jira through (the world mocks or the real servers)
GITHUB_MCP_URL=http://localhost:8101/mcp
JIRA_MCP_URL=http://localhost:8102/mcp
GITHUB_TOKEN=
GITHUB_REPO=
JIRA_BASE_URL=
# Atlassian cloud id; defaults to JIRA_BASE_URL
JIRA_CLOUD_ID=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Optional: seconds to reach an MCP server for the connector status (default 5)
# CONNECTOR_TIMEOUT=
# Optional: seconds the write-up waits after a meeting ends for the last transcript segments
# (default 8)
# PIPELINE_SETTLE_SECONDS=
# Optional: minutes without progress after which the host may retry a write-up that is not
# running here, e.g. after a crash (default 10)
# PIPELINE_STALE_MINUTES=

# brain + realtime
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BRAIN_URL=http://localhost:8000
# At least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRAIN_INTERNAL_TOKEN=
# brain lists the agent voices and reads reports aloud with it; realtime transcribes and speaks
ELEVENLABS_API_KEY=
# Optional: defaults to https://api.elevenlabs.io
# ELEVENLABS_API_URL=
# The agent's default voice and speech model: realtime's spoken answers and the report's Listen
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=

# realtime
ELEVENLABS_STT_MODEL=

# world
WORLD_SNAPSHOT=dev
WORLD_TODAY_OVERRIDE=
